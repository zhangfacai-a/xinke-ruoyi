{
  "manifest_version": 3,
  "name": "巨量百应主播班次上报",
  "version": "2.0.1",
  "description": "读取巨量百应五项直播指标并自动匹配直播场次上报",
  "permissions": ["storage"],
  "host_permissions": ["http://47.116.62.234/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "打开巨量百应班次上报", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["dom-collector.js", "content.js"], "run_at": "document_start"}]
}
